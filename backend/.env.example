PORT=8000

# Учётная запись администратора, которую создаёт `python seed.py`
# (вход в админ-панель по email и паролю, токен JWT):
ADMIN_EMAIL=admin@shelter.local
ADMIN_PASSWORD=admin123

# Строку подключения создаёт автоматически setup_db.py:
DATABASE_URL=postgresql+asyncpg://shelter:shelter@localhost:5432/animal_shelter

# Секрет для подписи JWT-токенов (поменяйте на свою случайную строку):
JWT_SECRET=change-me-to-random-string
JWT_EXPIRES_DAYS=7
