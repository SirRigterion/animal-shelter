# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env НЕ коммитится в git.

# --- PostgreSQL ---
POSTGRES_DB=animal_shelter
POSTGRES_USER=shelter
POSTGRES_PASSWORD=change-me-db-password

# --- Backend ---
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-to-random-string
JWT_EXPIRES_DAYS=7

# Администратор (создаётся при RUN_SEED=true)
ADMIN_EMAIL=admin@shelter.local
ADMIN_PASSWORD=change-me-admin-password

# true – при старте создать администратора и 8 демо-питомцев (безопасно повторять).
# После первого запуска можно поставить false.
RUN_SEED=true

# CORS нужен только если фронтенд открывается с другого домена (обычно пусто)
CORS_ORIGINS=

# --- Порт на сервере, на котором открывается сайт ---
HTTP_PORT=80
